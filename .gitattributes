# Keep the release archive to what a Kanboard installation actually loads.
# `git archive` honours these, so `make archive` and the release workflow both
# produce the same lean zip. Everything here stays in the repository; it is
# only left out of the distributed build.

/.gitattributes export-ignore
/.gitignore     export-ignore
/.github        export-ignore
/Makefile       export-ignore
/Test           export-ignore
/docs           export-ignore
/tools          export-ignore
